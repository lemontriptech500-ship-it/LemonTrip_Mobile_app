{
  "expo": {
    "name": "LemonTrip",
    "slug": "LemonTripMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lemontripmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.gokul.lemontrip",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.gokul.lemontrip",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B5D2A",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F3D2E"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "UpcomingTrip",
              "label": "LemonTrip: Upcoming Trip",
              "description": "Your next trip at a glance",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-build-properties",
      "@react-native-google-signin/google-signin",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d350722c-2eb4-475b-aa80-a60f00827262"
      }
    },
    "owner": "gokulsir500"
  }
}
